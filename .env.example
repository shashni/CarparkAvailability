# Copy to .env (git-ignored) for local runs. In GitHub Actions these come from repository/environment secrets.

# LifeTime Deployment API v2 (Enterprise / Infrastructure subscriptions only)
LIFETIME_URL=https://your-lifetime-host.outsystemsenterprise.com
LIFETIME_TOKEN=

# Optional data.gov.sg API key. Leave empty to use the anonymous, rate-limited tier.
CARPARK_DATAGOV_API_KEY=

# Environment the smoke/e2e tests target: personal | development | test | production
CARPARK_ENV=personal
