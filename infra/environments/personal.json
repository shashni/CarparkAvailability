  },
  "secrets": {
    "DataGovApiKey": { "fromEnv": "CARPARK_DATAGOV_API_KEY", "required": false }
  },
  "checks": {
    "minCarparks": 1500,
    "requireLocationData": true,
    "maxDataAgeMinutes": 15
  }
