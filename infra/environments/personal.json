{
  "$schema": "../schemas/environment.schema.json",
  "name": "personal",
  "kind": "personal",
  "enabled": true,
  "description": "OutSystems personal environment. No LifeTime: publish from Service Studio, then run `carpark-ops verify --env personal`.",
